# OpenAlex now needs an API key for real use (since early 2026). It is free.
# Make an account at https://openalex.org and copy the key from https://openalex.org/settings/api
# A free key gives about 1 USD of usage per day. This week's whole run costs a few cents.
OPENALEX_API_KEY=paste_your_key_here

# Your email. Optional, still sent as the mailto parameter. Not a secret.
OPENALEX_MAILTO=you@example.com
